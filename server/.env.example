# Server Port
PORT=5000

# Node Environment (development, test, production)
NODE_ENV=development

# MongoDB Connection String
# Leave empty to automatically use in-memory embedded MongoDB
# Or set your MongoDB URI:
# MONGODB_URI=mongodb://localhost:27017/lead_tracker
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lead_tracker?retryWrites=true&w=majority
MONGODB_URI=

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173
